# GoodMem REST server root (no /v1, /mcp, or gRPC port).
GOODMEM_BASE_URL=http://localhost:8088
GOODMEM_API_KEY=

# Existing embedder ID OR a key to register an embedder during setup.
GOODMEM_EMBEDDER_ID=
GOODMEM_EMBEDDING_MODEL=embed-v4.0
EMBEDDING_API_KEY=
COHERE_API_KEY=

# Groq preserves the upstream default. Cohere can use the same key for chat.
CHAT_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# One-provider alternative: CHAT_PROVIDER=cohere, CHAT_MODEL=command-a-03-2025

# Optional existing reranker, or run setup --with-reranker with COHERE_API_KEY.
GOODMEM_RERANKER_ID=
GOODMEM_RERANKER_MODEL=rerank-v3.5
GOODMEM_NAMESPACE=agentic-rag-goodmem
GOODMEM_TIMEOUT=120
GOODMEM_INGEST_TIMEOUT=600
